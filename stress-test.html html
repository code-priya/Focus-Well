<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stress Assessment - Focus Well</title>
    <link rel="stylesheet" href="css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <i class="fas fa-brain"></i>
                <span>Focus Well</span>
            </div>
            <ul class="nav-menu">
                <li><a href="index.html">Home</a></li>
                <li><a href="stress-test.html" class="active">Stress Test</a></li>
                <li><a href="resources.html">Resources</a></li>
                <li><a href="about.html">About</a></li>
            </ul>
            <div class="nav-buttons">
                <button class="btn btn-outline">Sign In</button>
                <button class="btn btn-primary">Get Started</button>
            </div>
        </div>
    </nav>

    <section class="page-header">
        <h1>Stress Assessment Test</h1>
        <p>Answer these 10 questions honestly to get an accurate stress level prediction</p>
    </section>

    <section class="test-container">
        <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
        </div>
        
        <form id="stressTestForm">
            <div class="question-container" id="questionContainer">
                <!-- Questions will be dynamically loaded here -->
            </div>
            
            <div class="test-navigation">
                <button type="button" class="btn btn-outline" id="prevBtn" onclick="changeQuestion(-1)" disabled>Previous</button>
                <span id="questionCounter">Question 1 of 10</span>
                <button type="button" class="btn btn-primary" id="nextBtn" onclick="changeQuestion(1)">Next</button>
                <button type="submit" class="btn btn-success" id="submitBtn" style="display: none;">Get Results</button>
            </div>
        </form>
    </section>

    <script src="js/stress-test.js"></script>
</body>
</html>
